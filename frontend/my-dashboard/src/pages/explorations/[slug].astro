---
import { getExploration, getActivationsByExploration } from "../../lib/sanity"
import Layout from "../../layouts/Layout.astro"
import ExplorationHeader from "../../components/sections/ExplorationHeader.astro"
import ActivationsList from "../../components/sections/ActivationsList.astro"
import PortableTextRenderer from "../../components/ui/PortableTextRenderer.vue"

const { slug } = Astro.params
const exploration = await getExploration(slug)
if (!exploration) {
  return Astro.rewrite('/404')
}
const activations = await getActivationsByExploration(exploration._id)
const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": exploration.title,
  "description": exploration.summary,
  "image": exploration.coverImage,
  "author": {
    "@type": "Organization",
    "name": "SomeSeeds",
    "url": new URL('/', Astro.site).href
  }
}


---

<Layout
  title={exploration.seo?.metaTitle ?? exploration.title}
  description={exploration.seo?.metaDescription ?? exploration.summary}
  image={exploration.seo?.ogImage ?? exploration.coverImage}
  noIndex={exploration.seo?.noIndex}
  seoType="article"
  jsonLd={jsonLd as Record<string, unknown>}
>
  <ExplorationHeader
    title={exploration.title}
    description={exploration.summary}
    image={exploration.coverImage}
    category={exploration.category}
    tags={exploration.tags}
  />
 <div class="container_grid_two_rows">
  {exploration.body && (
        <div class="body_text p_medium">
        <PortableTextRenderer body={exploration.body} client:load />
        </div>
  )}

  {exploration.collaborators && exploration.collaborators.length > 0 && (
    <div class="optional_box">
      <h2 class="heading-m">Collaborators</h2>
      <div class="collaborators">
        {exploration.collaborators.map(c => (
          <div class="collaborator">
            {c.logo && <img src={c.logo} alt={c.name} />}
            {c.url
              ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
              : <span>{c.name}</span>
            }
          </div>
        ))}
      </div>
    </div>
  )}
 </div>
  {(exploration.activationsTitle || exploration.activationsDescription) && (
    <div class="container_grid_two_rows activations_header">
      {exploration.activationsTitle && <h2 class="display_l activations_title">{exploration.activationsTitle}</h2>}
      {exploration.activationsDescription && <p class="body_s activations_desc">{exploration.activationsDescription}</p>}
    </div>
  )}
  <ActivationsList activations={activations} emptyMessage={exploration.emptyActivationsMessage} />
</Layout>

<style>


:global(.container_grid_two_rows) {
    padding: var(--space-8) var(--space-8);
}

/* On mobile, match the 90vw / no-side-padding inset used by the header and the
   rest of the page so every text block lines up at the same left edge. */
@media (max-width: 820px) {
  :global(.container_grid_two_rows) {
    padding: var(--space-8) 0;
  }
}

  .body_text {
     grid-area: a-2;
  }

  .optional_box {
    grid-area: a-4;
    gap: var(--space-6);
    padding: var(--space-4);
  }
.collaborators {
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
  align-items: center;
  padding: var(--space-4) 0;
}

.collaborator {
  display: flex;
  align-items: center;
  gap: 0.2rem;
}

.collaborator img {
  height: 2rem;
  width: auto;
}

.activations_title {
  grid-column: 2;
  grid-row: 1;
  padding-bottom: var(--space-8);
}

.activations_desc {
  grid-column: 2;
  grid-row: 2;
}
</style>