---
import PortableTextRenderer from '../ui/PortableTextRenderer.vue'
import CategoryTag from '../ui/CategoryTag.astro'
import TagPill from '../ui/TagPill.astro'

interface Props {
  title: string
  description?: string
  image?: string 
  category?: { title: string }
  tags?: { title: string }[]
  credits?: any[]
  type?: string
  startDate?: string
  startTime?: string
  endDate?: string
  endTime?: string
  location?: { venue?: string; city?: string; country?: string }
  partnerInstitutions?: { name?: string; logo?: string; url?: string }[]
}

const { title, image, category, tags, credits, type, startDate, startTime, endDate, endTime, location, partnerInstitutions } = Astro.props

// ── Date formatting ───────────────────────────────────────
const formatDate = (dateStr: string) => {
  if (!dateStr) return ''
  const d = new Date(dateStr)
  return d.toLocaleDateString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric',
    timeZone: 'UTC'
  })
}

const isSameDay = startDate && endDate &&
  new Date(startDate).toDateString() === new Date(endDate).toDateString()
const isMultiDay = startDate && endDate && !isSameDay

let dateDisplay = ''
if (startDate) {
  if (isMultiDay) {
    const startDay = new Date(startDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' })
    const endFull = new Date(endDate!).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
    dateDisplay = `${startDay}–${endFull}`
  } else {
    dateDisplay = formatDate(startDate)
    if (startTime) {
      dateDisplay += ` · ${startTime}`
      if (endTime) dateDisplay += `–${endTime}`
    }
  }
}

const locationDisplay = location
  ? [location.venue, location.city, location.country].filter(Boolean).join(', ')
  : null

  const typeLabels: Record<string, string> = {
  'workshop': 'Workshop',
  'event': 'Event',
  'session': 'Session',
  'field-work': 'Field Work',
}

const typeDisplay = type ? (typeLabels[type] ?? type) : null
---


<section>
<div  class="first_wrapper">

<div class="container">

<h1 class="display_xl title_in_grid">{title}</h1>

 <div class="date_location__box">
{(dateDisplay || locationDisplay || typeDisplay) && (
  <>
  {typeDisplay && <h4 class="heading_xs">{typeDisplay}</h4>}
    {dateDisplay && <h5 class="title_l"><span class="date">{dateDisplay}</span></h5>}
    {locationDisplay && <h3 class="heading_s"><span class="location">{locationDisplay}</span></h3>}
  </>
)}

{partnerInstitutions && partnerInstitutions.length > 0 && (
  <div class="partners_box">
    {partnerInstitutions.map(p => (
      <div class="item_partner__box">
        {p.logo && <img src={p.logo} alt={p.name ?? ''} class="partner__logo" />}
      </div>
    ))}
  </div>

)}
  </div>

</div>

<div class="image_box">{image && <img src={image} alt={title} />}</div>

</div>


<div class="description_grid">
<div class="tags_cat__box">
  {category && <CategoryTag label={category.title} />}
  {tags && tags.length > 0 && (
    tags.map(tag => <TagPill label={tag.title} />)
  )}
</div>
{credits && (
  <div class="portable-text p_lead">
    <PortableTextRenderer body={credits} client:load />
  </div>
)}
</div>

</section>

<style>

 /* -----First wrapper----- */
.first_wrapper {
  display: flex;
  flex-direction: row;
  height: 80vh; 
  align-content: space-around;
}

.container {
  display: flex;
  flex-direction: column;
  width: 48vw;
  height: 100%; 
  gap: var(--space-16);
  justify-content: end;
}
.title_in_grid {
  padding-top: var(--space-8);
}

.date_location__box{
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.partners_box{
  display: flex;
  flex-wrap: wrap;
  flex-direction: row;
  justify-content: start;
  gap: var(--space-4);
  padding: var(--space-6) 0;
}

.partner__logo {
 width: auto;
 height: 2.8rem;
}

.image_box {
  display: flex;
  flex: 1;
  min-height: 0;
  justify-content: center;
  align-items: center;
  grid-area: Area;
  width: auto;
  height: 100%;
}
.image_box img {
  min-height: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}


 /* -----Second wrapper----- */

.description_grid {
  display: grid;
  grid-template-columns: 18vw 1fr 18vw;
  grid-template-rows: auto auto;
  gap: 2rem;
  grid-template-areas:
    "B-Area  B-Area-2 B-4"
    "B-Area  B-Area-3 B-5";
  padding: var(--space-16) var(--space-4);
}
.tags_cat__box{  
  display: flex;
  flex-wrap: wrap;
  flex-direction: row;
  justify-content: center;
  gap: var(--space-4);
  padding: var(--space-0) 0; 
  grid-area: B-Area-2;
  max-width: 68ch; 
}

.portable-text {
  width: 100%;
  grid-area: B-Area-3;
}


@media (max-width: 768px) {

}
</style>