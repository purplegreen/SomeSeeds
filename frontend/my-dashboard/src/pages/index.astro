---
import Layout from '../layouts/Layout.astro'
import PortableTextRenderer from '../components/ui/PortableTextRenderer.vue'
import CardsSlider from '../components/ui/CardsSlider.vue'
import Button from '../components/ui/Button.vue'
import { getHomepage } from '../lib/sanity'


const homepage = await getHomepage()

const approach   = homepage?.sections?.find((s: any) => s.key === 'approach')
const explorations = homepage?.sections?.find((s: any) => s.key === 'explorations')
const getInvolved = homepage?.sections?.find((s: any) => s.key === 'get-involved')
---

<Layout
  title="SomeSeeds"
  description="An interdisciplinary research initiative exploring restorative practices, regenerative principles, and modes of coexistence among life forms and their ecosystems."
>

  <!-- ── 1. Hero ──────────────────────────────────────── -->
  <section class="hero">

    {homepage?.heroText && (
      <h1 class="hero__text">{homepage.heroText}</h1>
    )}
  <div class="hero__svg hero__svg--one">
  <img src="/bacter.svg" alt="" aria-hidden="true" />
</div>

<div class="hero__svg hero__svg--two">
  <img src="/moves.svg" alt="" aria-hidden="true" />
</div>
  
  </section>

  <!-- ── Fixed Scroll Bar ─────────────────────────────── -->
<div class="scroll-bar" aria-hidden="false">
  {homepage?.scrollBarSvgOne && (
    <img src={homepage.scrollBarSvgOne} alt="" class="scroll-bar__svg scroll-bar__svg--one" />
  )}
  {homepage?.scrollBarSvgTwo && (
    <a href="#top" aria-label="Back to top">
      <img src={homepage.scrollBarSvgTwo} alt="Back to top" class="scroll-bar__svg scroll-bar__svg--two" />
    </a>
  )}
</div>

  <!-- ── 2. Approach ──────────────────────────────────── -->
  {approach && (
    <section class="home-section">
      <div class="container_grid_one_row">
        <div class="section__content bg_full">
          <h2 class="display_xl">{approach.title}</h2>
          {approach.description && (
            <div class="heading_m_p">
              <PortableTextRenderer body={approach.description} client:load />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ── 3. Poster Image 1 ────────────────────────────── -->
  {homepage?.posterImageOne && (
    <div class="poster">
      <img src={homepage.posterImageOne} alt="" class="poster__image" />
    </div>
  )}

  <!-- ── 4. Explorations ──────────────────────────────── -->
  {explorations && (
    <section class="home-section">
      <div class="container_grid_one_row">
        <div class="section__content bg_full">
          <h2 class="display_xl">{explorations.title}</h2>
          {explorations.description && (
            <div class="heading_m_p">
              <PortableTextRenderer body={explorations.description} client:load />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ── 5. Slider ────────────────────────────────────── -->
  {homepage?.slider && homepage.slider.length > 0 && (
    <div class="home-slider">
      <CardsSlider items={homepage.slider} gap={12} client:load />
    </div>
  )}

  <!-- ── 6. Poster Image 2 ────────────────────────────── -->
  {homepage?.posterImageTwo && (
    <div class="poster">
      <img src={homepage.posterImageTwo} alt="" class="poster__image" />
    </div>
  )}

  <!-- ── 7. Get Involved ──────────────────────────────── -->
  {getInvolved && (
    <section class="home-section">
        <div class="container_grid_two_rows">
        <div class="two_row__content bg_full">
          <h2 class="display_xl">{getInvolved.title}</h2>
          {getInvolved.description && (
            <div class="heading_m_p">
              <PortableTextRenderer body={getInvolved.description} client:load />
            </div>
          )}
              <div class="cta-box">
              <Button href="/contact" variant="primary" size="md" client:load>
          Get In Touch
        </Button>
          </div>
        </div>
    
      </div>
    </section>
  )}

</Layout>

<style>
/* ── Hero ─────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: flex-end;
  padding: var(--space-8);
}


h1 {
  font-size: 16vh;
  line-height: 0.9;

}
.hero__text{
  position: relative;
  z-index: 1;
  max-width: 80vw;
  align-self: center;
  color: var(--color-primary);
  padding-left: var(--space-10);
  mix-blend-mode: multiply;
}

.hero__svg {
  position: fixed;
  z-index: 2;
}

.hero__svg--one {
  left: 10%;
  top: 40%;
  z-index: 2;
  mix-blend-mode: hard-light;
}

.hero__svg--two {
  top: 10%;
 right: 15%;
   mix-blend-mode: hard-light;
}

.hero__svg img {
  width: 40vw;
  height: auto;
}

/* ── Fixed Scroll Bar ─────────────────────────────── */


.scroll-bar__svg--one {
  height: 106vh;
  width: auto;
  position: fixed;
  right: -1%;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  z-index: 150;
  pointer-events: none;
}

.scroll-bar__svg--two {
  width: 6rem;
  height: auto;
  position: fixed;
  right: 0%;
 z-index: 160;
  pointer-events: auto;
  mix-blend-mode: exclusion;
}

/* ── Sections ─────────────────────────────────────── */
.home-section {
  padding: var(--space-8) 0;
}

.section__content {
  grid-area: a-2;
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.bg_full {
  background-color: white;
  position: relative;
  padding: var(--space-6);
  border-radius: var(--radius-lg);
  z-index: 10;
}


.two_row__content {
  grid-area: a-2;
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.cta-box {
  grid-area: a-4;
  display: flex;
  justify-content: flex-start;
  margin-top: var(--space-0);
  justify-self: center;
}

/* ── Poster ───────────────────────────────────────── */
.poster {
  width: 99vw;
  position: relative;
  left: 50%;
  transform: translateX(-50%);
  margin: 0;
}

.poster__image{
  width: 100%;
  height: auto;
  display: block;
}
/* ── Slider ───────────────────────────────────────── */
.home-slider {
  padding: var(--space-12) 0;
  z-index: 10;
}

  :global(.cards-slider__arrow--next) {
    margin-right: 9vw;
  }


</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  // SVG one — rotates clockwise
  gsap.to('.hero__svg--one img', {
    rotation: 360,
    ease: 'none',
    scrollTrigger: {
      trigger: 'body',
      start: 'top top',
      end: `+=${window.innerHeight * 5}`,
      scrub: 1,
    }
  })

  // SVG two — rotates counter-clockwise
  gsap.to('.hero__svg--two img', {
    rotation: -360,
    ease: 'none',
   scrollTrigger: {
      trigger: 'body',
      start: 'top top',
      end: '+=3000',
      scrub: 1,
    }
  })

  // scroll-bar svg two — moves from bottom to top as page scrolls
gsap.fromTo('.scroll-bar__svg--two', 
  { top: '85vh' },  // starts at bottom
  {
    top: '1vh',    // ends at top
    ease: 'none',
    scrollTrigger: {
      trigger: 'body',
      start: 'top top',
      end: `+=${document.body.scrollHeight}`,
      scrub: 1,
    }
  }
)
</script>