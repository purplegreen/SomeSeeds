---
import PortableTextRenderer from '../ui/PortableTextRenderer.vue'

interface Props {
  outcomes?: {
    label?: string
     text?: any[]
    url?: string
    internalRef?: { _type: string; title: string; slug: { current: string } }
  }[]
}

const { outcomes } = Astro.props
---

{outcomes && outcomes.length > 0 && (
  <section>
    <div class="container_grid">
    <h2 class="display_l">Threads</h2>
    <ul class="outcomes-list">
      {outcomes.map(outcome => (
        <li class="outcome">
          {outcome.label && (
            <span class="outcome__label">{outcome.label}</span>
          )}
            {outcome.text && (
              <PortableTextRenderer body={outcome.text} client:load /> 
            )}
          {outcome.url && (
            
            <a  href={outcome.url}
              target="_blank"
              rel="noopener noreferrer"
              class="outcome__link underline-hover"
            >
              {outcome.url}
            </a>
          )}
          {outcome.internalRef && (
            
          <a  href={`/${outcome.internalRef._type}s/${outcome.internalRef.slug}`}
              class="outcome__link underline-hover"
            >
              {outcome.internalRef.title}
            </a>
          )}
        </li>
      ))}
    </ul>
    </div>
  </section>
)}

<style>

.display_l {
  grid-area: a-1;
  padding-left: var(--space-24);
}

/* On mobile the grid collapses to a single 90vw column — drop the left inset
   so the title aligns with the body text below it. */
@media (max-width: 768px) {
  .display_l {
    padding-left: 0;
  }
}

.outcomes-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  grid-area: a-5; 
}

.outcome {
  display: flex;
  flex-direction: column;
  gap: var(--space-0);
}

.outcome__label {
  font-size: var(--text-body);
  font-weight: 600;
}

.outcome__link {
  font-size: var(--text-m);
  opacity: 0.7;
}
</style>