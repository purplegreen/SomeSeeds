{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run start)",
      "Bash(npm run deploy)",
      "Bash(npm install)",
      "Bash(npx sanity *)",
      "Bash(sanity *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm run deploy)",
      "Bash(sanity deploy*)",
      "Bash(npx sanity deploy*)",
      "Bash(sanity dataset delete*)",
      "Bash(npx sanity dataset delete*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(~/.ssh/*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(sudo *)",
      "Bash(git reset --hard*)"
    ]
  }
}
