---
import Layout from "../layouts/Layout.astro"

Astro.response.status = 404
---

<Layout title="Page not found" description="The page you’re looking for doesn’t exist." noIndex={true}>
  <section class="not-found container_grid_one_row">
    <div class="not-found__content">
      <h1 class="display_xl">404</h1>
      <p class="p_lead">This page doesn’t exist — or has grown into something else.</p>
      <a href="/" class="not-found__link">Back to home</a>
    </div>
  </section>
</Layout>

<style>
  .not-found__content {
    grid-area: a-2;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
    padding-block: var(--space-24);
  }
  .not-found__link {
    text-underline-offset: var(--space-1);
  }
</style>
