---
import PortableTextRenderer from '../ui/PortableTextRenderer.vue'

interface Props {
  title: string
  description: string
  image?: string 
  body?: any[]
}


const { title, description, image, body } = Astro.props
---

<section>

  <div class="container_grid">
  <h1 class="display_l">{title}</h1>
  <div class="heading_m_p">
  {description}
 </div>
</div>


<section class="poster_section">
 <div class="image_wrapper">{image && <img src={image} alt={title} />    }</div>
</section>

  <div class="container_grid_one_row">
  <div class="portable_text">
  <PortableTextRenderer body={body} client:load />
  </div>
</div>
</section>

<style>

.display_l {
   grid-area: a-1;
}
  .heading_m_p {
    grid-area: a-5;
  }


  .portable_text {
    grid-area: a-2;
  }


img .image_wrapper{
  width: 100%;
  height: 40vh;
}
  

  @media (max-width: 768px) {
  .display_l {
  padding-left: var(--space-1);
}

  }
  @media (max-width: 480px) {

}
</style>