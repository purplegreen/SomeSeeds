---
export const prerender = true
import { getAllActivations, getActivation } from "../../lib/sanity"
import Layout from "../../layouts/Layout.astro"
import ContentHeader from "../../components/sections/ContentHeader.astro"
import PortableTextRenderer from "../../components/ui/PortableTextRenderer.vue"
import ImageSlider from "../../components/ui/ImageSlider.vue"
import CategoryTag from "../../components/ui/CategoryTag.astro"
import TagPill from "../../components/ui/TagPill.astro"


export async function getStaticPaths() {
  const activations = await getAllActivations()
  return activations.map((a: any) => ({
    params: { slug: a.slug },
  }))
}

const { slug } = Astro.params
const activation = await getActivation(slug)

// ── Documentation section locals ──────────────────────────
const research = activation.research
const documentation = activation.documentation
const outcomes = activation.outcomes
const overview = activation.overview
const category = activation.categories?.[0]
const tags = activation.tags

const posterImage = documentation?.posterImage
const sliderImages = documentation?.images?.map((img: { url: string; caption?: string }) => ({
  url: img.url,
  alt: img.caption ?? ''
})) ?? []

const typeLabels: Record<string, string> = {
  'workshop': 'Workshop',
  'event': 'Event',
  'session': 'Session',
  'field-work': 'Field Work',
}
const typeDisplay = activation.type ? (typeLabels[activation.type] ?? activation.type) : 'Documentation'
const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": activation.title,
  "startDate": activation.startDate,
  "endDate": activation.endDate ?? activation.startDate,
  "location": activation.location?.city ? {
    "@type": "Place",
    "name": activation.location.venue ?? activation.location.city,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": activation.location.city,
      "addressCountry": activation.location.country
    }
  } : undefined,
  "image": activation.coverImage,
  "organizer": {
    "@type": "Organization",
    "name": "SomeSeeds",
    "url": "https://www.someseeds.net"
  }
}

---

<Layout
  title={activation.title}
  description={activation.summary}
  image={activation.coverImage}
  seoType="article"
   jsonLd={jsonLd as Record<string, unknown>}
>
<ContentHeader
  title={activation.title}
  image={activation.coverImage}
  type={activation.type}
  startDate={activation.startDate}
  startTime={activation.startTime}
  endDate={activation.endDate}
  endTime={activation.endTime}
  location={activation.location}
  partnerInstitutions={activation.partnerInstitutions}
  credits={activation.credits}
/>


  {/* ── Documentation ─────────────────────────────────── */}
  {(overview || (documentation && (documentation.text || documentation.images?.length || documentation.posterImage))) && (
    <section>
      <div class="container_grid">
        <div class="doc-intro">
          {(category || tags?.length) && (
            <div class="tags_cat__box">
              {category && <CategoryTag label={category.title} />}
              {tags && tags.length > 0 && (
                tags.map((tag: { title: string }) => <TagPill label={tag.title} />)
              )}
            </div>
          )}
          {overview && (
            <div class="overview portable-text p_lead">
              <PortableTextRenderer body={overview} client:load />
            </div>
          )}
        </div>
      </div>

      {sliderImages.length > 0 && (
        <div class="slider-fullwidth">
          <ImageSlider images={sliderImages} client:load />
        </div>
      )}


      {documentation?.text && (
        <div class="container_grid">
           <h2 class="display_l">{typeDisplay}</h2>
          <div class="body_text p_medium">
            <PortableTextRenderer body={documentation.text} client:load />
          </div>
        </div>
      )}

      {posterImage && (
        <div class="poster">
          <img src={posterImage} alt="" />
        </div>
      )}
    </section>
  )}

  {/* ── Research ──────────────────────────────────────── */}
  {research && (research.text || research.images?.length || research.links?.length) && (
    <section>
      <div class="container_grid">
        <h2 class="display_l">Research</h2>
        <div class="body_text p_medium">
          {research.text && (
            <PortableTextRenderer body={research.text} client:load />
          )}
        </div>
      </div>

      <div class="image-gallery">
        {research.images?.map((img: { url: string; caption?: string }, i: number) => (
          <figure>
            <a href={`#img-${i}`}>
              {img.caption && <figcaption>{img.caption}</figcaption>}
              <img src={img.url} alt={img.caption ?? ""} />
            </a>

            <div class="lightbox" id={`img-${i}`}>
              <a href="#gallery" class="lightbox__close"><img src="/icons/close.svg" alt="Close" /></a>
              <img src={img.url} alt={img.caption ?? ""} />
            </div>
          </figure>
        ))}
      </div>

      {research.links && research.links.length > 0 && (
        <ul class="link-list">
          {research.links.map((link: { label?: string; url: string }) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label ?? link.url}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  {/* ── Outcomes (Threads) ────────────────────────────── */}
  {outcomes && outcomes.length > 0 && (
    <section>
      <div class="container_grid">
        <h2 class="display_l">Threads</h2>
        <ul class="outcomes-list">
          {outcomes.map((outcome: { label?: string; text?: any[]; url?: string; internalRef?: { _type: string; title: string; slug: { current: string } } }) => (
            <li class="outcome">
              {outcome.label && (
                <span class="outcome__label">{outcome.label}</span>
              )}
              {outcome.text && (
                <PortableTextRenderer body={outcome.text} client:load />
              )}
              {outcome.url && (
                <a href={outcome.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="outcome__link underline-hover"
                >
                  {outcome.url}
                </a>
              )}
              {outcome.internalRef && (
                <a href={`/${outcome.internalRef._type}s/${outcome.internalRef.slug}`}
                  class="outcome__link underline-hover"
                >
                  {outcome.internalRef.title}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Layout>

<style>
/* Shared section heading + body — used by Documentation, Research and Outcomes */
.display_l {
  grid-area: a-1;
  padding-left: var(--space-24);
}

.body_text {
  grid-area: a-5;
  padding-bottom: var(--space-16);
}

/* ── Documentation: tags row + Overview stacked in the center column ── */
.doc-intro {
  grid-area: a-5;
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}
.tags_cat__box {
  display: flex;
  flex-wrap: wrap;
  flex-direction: row;
  justify-content: center;   /* keep pills centered */
  gap: var(--space-4);
}

/* Full-bleed: break out of the centered content column to span the viewport */
.slider-fullwidth {
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
}

/* On mobile the grid collapses to a single 90vw column — drop the left inset
   so the title aligns with the body text below it. */
@media (max-width: 768px) {
  .display_l {
    padding-left: 0;
  }
}

/* ── Research: bento image gallery + lightbox + links ───── */

.image-gallery {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-auto-rows: 96vh; /* each row is one near-full-height band */
  gap: 0.75rem;
  padding: var(--space-2)
}

.image-gallery figure {
  position: relative;
  overflow: hidden;
  margin: 0;
  border-radius: var(--radius-sm);
}

.image-gallery figure:nth-child(8n + 3),
.image-gallery figure:nth-child(8n + 8) {
  grid-column: 1 / -1;   /* full width */
}

.image-gallery figure img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.image-gallery figure:hover img {
  transform: scale(1.04);
}

/* Caption appears on hover */
.image-gallery figcaption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0.5rem 0.75rem;
  background: rgba(255, 255, 255,0.9);
  color: black;
  display: flex;
  flex-wrap: wrap;
  font-size: var(--text-m);
  line-height: 1.1;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 10;
}

.image-gallery figure:hover figcaption {
  opacity: 1;
}

.link-list {
  margin-top: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding-left: var(--space-4);
}

.link-list a {
  font-size: var(--text-m);
}

.lightbox {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(255, 255, 255, 0.85);
  z-index: 999;
  justify-content: center;
  align-items: center;
}

/* Opens when the id is targeted via the URL hash */
.lightbox:target {
  display: flex;
}

.lightbox img {
  max-width: 90vw;
  max-height: 90vh;
  object-fit: contain;
  border-radius: var(--radius-md);
}

.lightbox__close {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  color: rgb(0, 0, 0);
  width: auto;
  text-decoration: none;
}

/* ── Outcomes (Threads) list ───────────────────────────── */
.outcomes-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  grid-area: a-5;
}

.outcome {
  display: flex;
  flex-direction: column;
  gap: var(--space-0);
}

.outcome__label {
  font-size: var(--text-body);
  font-weight: 600;
}

.outcome__link {
  font-size: var(--text-m);
  opacity: 0.7;
}
</style>