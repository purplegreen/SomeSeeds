---
export const prerender = false
import { getContactPage } from "../lib/sanity"
import Layout from "../layouts/Layout.astro"
import PortableTextRenderer from "../components/ui/PortableTextRenderer.vue"
import ContactForm from "../components/ui/ContactForm.vue"

const data = await getContactPage()
---

<Layout
  title={data?.seo?.metaTitle ?? data?.title}
  description={data?.seo?.metaDescription ?? data?.description}
  image={data?.seo?.ogImage}
>
  <section class="container_grid_three_rows grid_pad_wide">

    <h1 class="display_xl title">{data?.title}</h1>

    {data?.body && (
      <div class="portable_text">
        <PortableTextRenderer body={data.body} client:load />
      </div>
    )}

    {data?.formFields?.length > 0 && (
      <div class="form_area">
        <ContactForm
          formFields={data.formFields}
          submitButtonLabel={data.submitButtonLabel}
          successMessage={data.successMessage}
          client:load
        />
      </div>
    )}

  </section>
</Layout>

<style>
.title {
  grid-area: a-1;
}

.portable_text {
  grid-area: a-4;
  margin-top: var(--space-6);
}

.form_area {
  grid-area: a-6;
  margin-top: var(--space-8);
}
</style>
