---
import PortableTextRenderer from '../ui/PortableTextRenderer.vue'

interface Props {
  title: string
  description?: string
  image?: string
  credits?: any[]
  type?: string
  startDate?: string
  startTime?: string
  endDate?: string
  endTime?: string
  location?: { venue?: string; city?: string; country?: string }
  partnerInstitutions?: { name?: string; logo?: string; url?: string }[]
}

const { title, image, credits, type, startDate, startTime, endDate, endTime, location, partnerInstitutions } = Astro.props

// ── Date formatting ───────────────────────────────────────
const formatDate = (dateStr: string) => {
  if (!dateStr) return ''
  const d = new Date(dateStr)
  return d.toLocaleDateString('en-GB', {
    day: 'numeric', month: 'short', year: 'numeric',
    timeZone: 'UTC'
  })
}

const isSameDay = startDate && endDate &&
  new Date(startDate).toDateString() === new Date(endDate).toDateString()
const isMultiDay = startDate && endDate && !isSameDay

let dateDisplay = ''
if (startDate) {
  if (isMultiDay) {
    const startDay = new Date(startDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' })
    const endFull = new Date(endDate!).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
    dateDisplay = `${startDay}–${endFull}`
  } else {
    dateDisplay = formatDate(startDate)
    if (startTime) {
      dateDisplay += ` · ${startTime}`
      if (endTime) dateDisplay += `–${endTime}`
    }
  }
}

const locationDisplay = location
  ? [location.venue, location.city, location.country].filter(Boolean).join(', ')
  : null

  const typeLabels: Record<string, string> = {
  'workshop': 'Workshop',
  'event': 'Event',
  'session': 'Session',
  'field-work': 'Field Work',
  'open-observation': 'Open Observation',
}

const typeDisplay = type ? (typeLabels[type] ?? type) : null
---


<section>
<div  class="first_wrapper">

<div class="container">

<h1 class="display_xl title_in_grid">{title}</h1>

 <div class="date_location__box">
{(dateDisplay || locationDisplay || typeDisplay) && (
  <>
  {typeDisplay && <h4 class="heading_xs">{typeDisplay}</h4>}
    {dateDisplay && <h5 class="title_l"><span class="date">{dateDisplay}</span></h5>}
    {locationDisplay && <h3 class="heading_s"><span class="location">{locationDisplay}</span></h3>}
  </>
)}

{partnerInstitutions && partnerInstitutions.length > 0 && (
  <div class="partners_box">
    {partnerInstitutions.map(p => (
      <div class="item_partner__box">
        {p.logo && <img src={p.logo} alt={p.name ?? ''} class="partner__logo" />}
      </div>
    ))}
  </div>

)}

{credits && (
  <div class="credits portable-text">
    <PortableTextRenderer body={credits} client:load />
  </div>
)}
  </div>

</div>

<div class="image_box">{image && <img src={image} alt={title} />}</div>

</div>

</section>

<style>

 /* -----First wrapper----- */
.first_wrapper {
  display: flex;
  flex-direction: row;
  height: 88vh; 
  align-content: space-around;
}

.container {
  display: flex;
  flex-direction: column;
  width: 48vw;
  height: 100%; 
  gap: var(--space-8);
  justify-content: end;
}
.title_in_grid {
  padding-top: var(--space-8);
}

.date_location__box{
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.partners_box{
  display: flex;
  flex-wrap: wrap;
  flex-direction: row;
  justify-content: start;
  gap: var(--space-4);
  padding: var(--space-6) 0;
}

.partner__logo {
 width: auto;
 height: 2.8rem;
}

.credits {           
  font-size: var(--text-ml);
  font-weight: 560;
  line-height: 1.3;
}

.image_box {
  display: flex;
  flex: 1;
  min-height: 0;
  justify-content: center;
  align-items: center;
  grid-area: Area;
  width: auto;
  height: 100%;
}
.image_box img {
  min-height: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}



@media (max-width: 820px) {
  /* Stack title above image, both at the same 90vw as the body text below */
  .first_wrapper {
    flex-direction: column;
    height: auto;
    width: 90vw;
    margin-inline: auto;
    gap: var(--space-8);
    padding: var(--space-8) 0;
  }

  .container {
    width: 100%;
    gap: var(--space-8);
    /* Cancel the 24px padding-inline leaked in by the global `.container`
       utility (class-name collision) so the title lines up at the 90vw left
       edge with the description and body sections. */
    padding-inline: 0;
  }

  .image_box {
    width: 100%;
    height: auto;
  }

  .image_box img {
    width: 100%;
    height: auto;
    max-height: 60vh;
    object-fit: cover;
  }
}
</style>