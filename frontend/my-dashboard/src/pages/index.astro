---
export const prerender = true
import Layout from '../layouts/Layout.astro'
import PortableTextRenderer from '../components/ui/PortableTextRenderer.vue'
import CardsSlider from '../components/ui/CardsSlider.vue'
import Button from '../components/ui/Button.vue'
import { getHomepage } from '../lib/sanity'


const homepage = await getHomepage()

const approach   = homepage?.sections?.find((s: any) => s.key === 'approach')
const explorations = homepage?.sections?.find((s: any) => s.key === 'explorations')
const getInvolved = homepage?.sections?.find((s: any) => s.key === 'get-involved')
---

<Layout
  title={homepage?.seo?.metaTitle ?? 'SomeSeeds'}
  description={homepage?.seo?.metaDescription ?? 'An interdisciplinary research initiative exploring restorative practices, regenerative principles, and modes of coexistence among life forms and their ecosystems.'}
  image={homepage?.seo?.ogImage}
>

  <!-- ── 1. Hero ──────────────────────────────────────── -->
  <section class="hero">

    {homepage?.heroText && (
      <h1 class="hero__text">{homepage.heroText}</h1>
    )}
  <div class="hero__svg hero__svg--one">
  <img src="/bacter.svg" alt="" aria-hidden="true" />
</div>

<div class="hero__svg hero__svg--two">
  <img src="/moves.svg" alt="" aria-hidden="true" />
</div>
  
  </section>

  <!-- ── Fixed Scroll Bar ─────────────────────────────── -->
<div class="scroll-bar" aria-hidden="false">
  {homepage?.scrollBarSvgOne && (
    <img src={homepage.scrollBarSvgOne} alt="" class="scroll-bar__svg scroll-bar__svg--one" />
  )}
  {homepage?.scrollBarSvgTwo && (
    <a href="#top" aria-label="Back to top">
      <img src={homepage.scrollBarSvgTwo} alt="Back to top" class="scroll-bar__svg scroll-bar__svg--two" />
    </a>
  )}
</div>

  <!-- ── 2. Approach ──────────────────────────────────── -->
  {approach && (
    <section class="home-section">
      <div class="container_grid">
        <h2 class="display_xl">{approach.title}</h2>
        {approach.description && (
          <div class="p_medium">
            <PortableTextRenderer body={approach.description} client:load />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ── 3. Poster Image 1 ────────────────────────────── -->
  {homepage?.posterImageOne && (
    <div class="poster">
      <img src={homepage.posterImageOne} alt="" class="poster__image" />
    </div>
  )}

  <!-- ── 4. Explorations ──────────────────────────────── -->
  {explorations && (
    <section class="home-section">
      <div class="container_grid">
        <h2 class="display_xl">{explorations.title}</h2>
        {explorations.description && (
          <div class="p_medium">
            <PortableTextRenderer body={explorations.description} client:load />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ── 5. Slider ────────────────────────────────────── -->
  {homepage?.slider && homepage.slider.length > 0 && (
    <div class="home-slider" id="slider">
      <CardsSlider items={homepage.slider} gap={12} client:load />
    </div>
  )}



  <!-- ── 6. Get Involved ──────────────────────────────── -->
  {getInvolved && (
    <section class="home-section">
      <div class="container_grid">
        <h2 class="display_xl">{getInvolved.title}</h2>
        <div class="section__body">
          {getInvolved.description && (
            <div class="p_medium">
              <PortableTextRenderer body={getInvolved.description} client:load />
            </div>
          )}
          <div class="cta-box">
            <Button href="/contact" variant="primary" size="md" client:load>
              Get In Touch
            </Button>
          </div>
        </div>
      </div>
    </section>
  )}

    <!-- ── 7. Poster Image 2 ────────────────────────────── -->
  {homepage?.posterImageTwo && (
    <div class="poster">
      <img src={homepage.posterImageTwo} alt="" class="poster__image" />
    </div>
  )}

</Layout>

<style>
/* ── Hero ─────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  align-items: center;
 justify-content: center;
}


h1 {
  font-size: clamp(2.75rem, 13vw, 20vh);
  line-height: 0.76;
  font-weight: 490;

}
.hero__text{
  position: relative;
  z-index: 1;
  max-width: 90vw;
  align-self: center;
  color: var(--text-primary);
  padding-left: var(--space-10);
  mix-blend-mode: multiply;
  overflow-wrap: break-word;
}

.hero__svg {
  position: fixed;
  z-index: 2;
}

.hero__svg--one {
  left: 10%;
  top: 40%;
  z-index: 2;
  mix-blend-mode: hard-light;
}

.hero__svg--two {
  top: 10%;
 right: 15%;
   mix-blend-mode: hard-light;
}

.hero__svg img {
  width: 40vw;
  height: auto;
  will-change: transform;
}

/* ── Fixed Scroll Bar ─────────────────────────────── */


.scroll-bar__svg--one {
  height: 106vh;
  width: auto;
  position: fixed;
  right: -1%;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  z-index: 150;
  pointer-events: none;
}

.scroll-bar__svg--two {
  width: 6rem;
  height: auto;
  position: fixed;
  top: 0;
  right: 0%;
  z-index: 160;
  pointer-events: auto;
  mix-blend-mode: color-dodge;
  will-change: transform;
}

/* ── Sections ─────────────────────────────────────── */
.home-section {
  padding: 0;
}

.display_xl {
  grid-area: a-1;
  padding-left: var(--space-24);
}

.p_medium {
  grid-area: a-5;
}

.section__body {
  grid-area: a-5;
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.cta-box {
  display: flex;
  justify-content: flex-start;
}

/* ── Poster ───────────────────────────────────────── */
.poster {
  width: 99vw;
  position: relative;
  left: 50%;
  transform: translateX(-50%);
  margin: 0;
}

.poster__image{
  width: 100%;
  height: auto;
  display: block;
}
/* ── Slider ───────────────────────────────────────── */
.home-slider {
  background-color: var(--color-neutral-surface);
  padding: var(--space-2) 0;
  z-index: 10;
}

  :global(.cards-slider__arrow--next) {
    margin-right: 9vw;
  }

/* ── Mobile ───────────────────────────────────────── */
@media (max-width: 768px) {
  .hero__text {
    padding-left: var(--space-4);
  }

  .hero__svg img {
    width: 55vw;
  }

  .hero__svg--one {
    left: 5%;
  }

  .hero__svg--two {
    right: 5%;
  }

  .poster {
    width: 100%;
  }

  .display_xl {
    padding-left: 0;
  }
}

</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  // SVG one — rotates clockwise
  gsap.to('.hero__svg--one img', {
    rotation: 360,
    ease: 'none',
    scrollTrigger: {
      trigger: 'body',
      start: 'top top',
      end: `+=${window.innerHeight * 5}`,
      scrub: 1,
    }
  })

  // SVG two — rotates counter-clockwise
  gsap.to('.hero__svg--two img', {
    rotation: -360,
    ease: 'none',
   scrollTrigger: {
      trigger: 'body',
      start: 'top top',
      end: '+=3000',
      scrub: 1,
    }
  })

  // scroll-bar svg two — moves from bottom to top as page scrolls
  // Native scroll listener keeps this completely decoupled from GSAP scrub tweens
  const scrollBarTwo = document.querySelector('.scroll-bar__svg--two')
  if (scrollBarTwo) {
    const updateScrollBar = () => {
      const maxScroll = document.body.scrollHeight - window.innerHeight
      const progress = maxScroll > 0 ? Math.min(1, window.scrollY / maxScroll) : 0
      const y = window.innerHeight * (0.85 - 0.84 * progress)
      ;(scrollBarTwo as HTMLElement).style.transform = `translateY(${y}px)`
    }
    updateScrollBar()
    window.addEventListener('scroll', updateScrollBar, { passive: true })
  }
 document.querySelector('.scroll-bar a')?.addEventListener('click', (e) => {
    e.preventDefault()
    const scrollY = window.scrollY
    const target = scrollY < window.innerHeight 
      ? '#slider'
      : '#top'
    document.querySelector(target)?.scrollIntoView({ behavior: 'smooth' })
  })
</script>