---
import ActivationCard from '../ui/ActivationCard.astro'
import CardsSlider from '../ui/CardsSlider.vue'

interface Props {
  activations: any[]
  emptyMessage?: string
}

const { activations, emptyMessage } = Astro.props
---

{activations.length === 0 ? (
  <section class="section section--centered">
    <p class="no-content">{emptyMessage ?? 'No activations yet.'}</p>
  </section>
) : activations.length === 1 ? (
  <section class="section section--centered">
    <ActivationCard {...activations[0]} />
  </section>
) : (
  <section class="section">
    <CardsSlider items={activations} client:load />
  </section>
)}

<style>
.no-content {
  font-size: var(--text-2xl);
  font-weight: 630;
}

.section--centered {
  display: flex;
  justify-content: center;
}

/* On mobile, match the 90vw / no-side-padding inset used by the rest of the
   page so the empty-state message lines up at the same left edge.
   Compound selector (.section.section--centered) outranks the global
   `.section` padding so the side padding is reliably removed. */
@media (max-width: 820px) {
  .section.section--centered {
    width: 90vw;
    margin-inline: auto;
    padding: var(--space-8) 0;
    justify-content: flex-start;
  }
  .no-content {
    margin: 0;
    padding: 0;
  }
}
</style>