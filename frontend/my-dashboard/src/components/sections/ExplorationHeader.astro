---
import PortableTextRenderer from '../ui/PortableTextRenderer.vue'
import CategoryTag from '../ui/CategoryTag.astro'
import TagPill from '../ui/TagPill.astro'

interface Props {
  title: string
  description?: string
  image?: string 
  category?: { title: string }
  tags?: { title: string }[]
  body?: any[]
}

const { title, description, image, category, tags, body } = Astro.props

---

<section>

<div class="first_wrapper">
  <div class="container">
  <h1 class="display_xl">{title}</h1>
  <div class="tags_box">
  {category && <CategoryTag label={category.title} />}
  {tags && tags.length > 0 && (
    tags.map(tag => <TagPill label={tag.title} />)
  )}
</div>
  </div>
  <div class="image_wrapper">{image && <img src={image} alt={title} />}</div>
</div>

{(description) && (
  <div class="container_grid_one_row">
    {description && <p class="p_lead">{description}</p>}
  </div>
)}
 
</section>

<style>

:global(.container_grid_one_row) {
    padding: var(--space-8) var(--space-8);
}

.first_wrapper {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: var(--space-8);
  gap: var(--space-8);
}

.container {
  display: flex;
  flex-direction: column;
  width: 48vw;
  height: 100%; 
  gap: var(--space-16);
  justify-content: end;
}


.image_wrapper {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.image_wrapper img {
  max-height: 85vh;
  height: auto;
  width: auto;
  display: block;
}

.tags_box {
  display: flex;
  flex-wrap: wrap;
  align-items: start;
  gap: var(--space-4);
  margin-top: var(--space-2);
}

  .p_lead {
    grid-column: 2;
  }


@media (max-width: 768px) {
  .display_l {
    padding-left: 0;
  }

  /* Stack title above image, both at the same 90vw as the body text below */
  .first_wrapper {
    flex-direction: column;
    align-items: stretch;
    width: 90vw;
    margin-inline: auto;
    padding: var(--space-8) 0;
    gap: var(--space-8);
  }

  .container {
    width: 100%;
    gap: var(--space-8);
    /* Cancel the 24px padding-inline leaked in by the global `.container`
       utility (class-name collision) so the title aligns with the image
       and body text at the 90vw left edge. */
    padding-inline: 0;
  }

  .image_wrapper {
    width: 100%;
    justify-content: flex-start;
  }

  .image_wrapper img {
    width: 100%;
    height: auto;
    max-height: none;
  }

  /* Lead paragraph spans the full 90vw (drop the side padding) to match */
  :global(.container_grid_one_row) {
    padding: var(--space-8) 0;
  }
}
</style>