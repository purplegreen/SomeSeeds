---
import { getContactPage } from "../lib/sanity"
import Layout from "../layouts/Layout.astro"
import PortableTextRenderer from "../components/ui/PortableTextRenderer.vue"
import Button from "../components/ui/Button.vue"

const data = await getContactPage()
---

<Layout
  title={data?.seo?.metaTitle ?? data?.title}
  description={data?.seo?.metaDescription ?? data?.description}
  image={data?.seo?.ogImage}
>
  <section class="container_grid_three_rows">

    <h1 class="display_xl title">{data?.title}</h1>

    {data?.body && (
      <div class="portable_text">
        <PortableTextRenderer body={data.body} client:load />
      </div>
    )}

    {data?.destinationEmail && (
      <div class="form_area">
        <Button
          href={`mailto:${data.destinationEmail}`}
          variant="primary"
          size="md"
          client:load
        >
          Email us
        </Button>
      </div>
    )}

  </section>
</Layout>

<style>
.title {
  grid-area: a-1;
}

.portable_text {
  grid-area: a-4;
  margin-top: var(--space-6);
}

.form_area {
  grid-area: a-6;
  margin-top: var(--space-8);
  display: flex;
  justify-content: center;
}
</style>
