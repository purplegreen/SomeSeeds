---
import ActivationCard from '../ui/ActivationCard.astro'
import CardsSlider from '../ui/CardsSlider.vue'

interface Props {
  activations: any[]
  emptyMessage?: string
}

const { activations, emptyMessage } = Astro.props
---

{activations.length === 0 ? (
  <section class="section section--centered">
    <p class="no-content">{emptyMessage ?? 'No activations yet.'}</p>
  </section>
) : activations.length === 1 ? (
  <section class="section section--centered">
    <ActivationCard {...activations[0]} />
  </section>
) : (
  <section class="section">
    <CardsSlider items={activations} client:load />
  </section>
)}

<style>
.no-content {
  font-size: var(--text-2xl);
  font-weight: 630;
}

.section--centered {
  display: flex;
  justify-content: center;
}
</style>