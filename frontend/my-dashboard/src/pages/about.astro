---
import { getSimplePage } from "../lib/sanity"
import PageHeader from "../components/sections/PageHeader.astro"
import Layout from "../layouts/Layout.astro"

const data = await getSimplePage("about")
---

<Layout
  title={data?.title}
  description={data?.description}
  image={data?.image}
>
  <PageHeader 
    title={data?.title} 
    description={data?.description} 
    image={data?.image} 
    body={data?.body}
  />
</Layout>