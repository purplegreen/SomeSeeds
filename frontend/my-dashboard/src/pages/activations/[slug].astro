---
import { getAllActivations, getActivation } from "../../lib/sanity"
import Layout from "../../layouts/Layout.astro"
import ContentHeader from "../../components/sections/ContentHeader.astro"
import ActivationResearch from "../../components/sections/ActivationResearch.astro"
import ActivationDocumentation from "../../components/sections/ActivationDocumentation.astro"
import ActivationOutcomes from "../../components/sections/ActivationOutcomes.astro"


export async function getStaticPaths() {
  const activations = await getAllActivations()
  return activations.map((a: any) => ({
    params: { slug: a.slug },
  }))
}

const { slug } = Astro.params
const activation = await getActivation(slug)
const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": activation.title,
  "startDate": activation.startDate,
  "endDate": activation.endDate ?? activation.startDate,
  "location": activation.location?.city ? {
    "@type": "Place",
    "name": activation.location.venue ?? activation.location.city,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": activation.location.city,
      "addressCountry": activation.location.country
    }
  } : undefined,
  "image": activation.coverImage,
  "organizer": {
    "@type": "Organization",
    "name": "SomeSeeds",
    "url": "https://www.someseeds.net"
  }
}

---

<Layout
  title={activation.title}
  description={activation.summary}
  image={activation.coverImage}
  seoType="article"
   jsonLd={jsonLd as Record<string, unknown>}
>
<ContentHeader
  title={activation.title}
  image={activation.coverImage}
  tags={activation.tags}
  category={activation.categories?.[0]}
  type={activation.type}
  startDate={activation.startDate}
  startTime={activation.startTime}
  endDate={activation.endDate}
  endTime={activation.endTime}
  location={activation.location}
  partnerInstitutions={activation.partnerInstitutions}
  credits={activation.credits}
/>

  
  <ActivationDocumentation 
  type={activation.type} 
  documentation={activation.documentation} 
/>
  <ActivationResearch research={activation.research} />
  <ActivationOutcomes outcomes={activation.outcomes} />
</Layout>