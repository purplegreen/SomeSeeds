# Hashed build assets never change — cache them forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Root static assets — cache for a week.
/favicon.ico
  Cache-Control: public, max-age=604800
/og-default.jpg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
