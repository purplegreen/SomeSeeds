---
import PortableTextRenderer from '../ui/PortableTextRenderer.vue'

interface Props {
  title: string
  description: string
  image?: string
  body?: any[]
}


const { title, description, image, body } = Astro.props
---

<div class="hero__svg hero__svg--one">
  <img src="/bacter.svg" alt="" aria-hidden="true" />
</div>
<div class="hero__svg hero__svg--two">
  <img src="/moves.svg" alt="" aria-hidden="true" />
</div>

<section>

  <div class="container_grid_two_cols">
  <h1 class="heading_s_a">{title}</h1>
  <div class="p_lead">
  {description}
 </div>
</div>


<section class="poster_section">
 <div class="image_wrapper">{image && <img src={image} alt={title} />    }</div>
</section>

  <div class="container_grid">
  <div class="p_medium">
  <PortableTextRenderer body={body} client:load />
  </div>
</div>
</section>

<style>

.heading_s_a {
   grid-area: a-1;
}
  .p_lead {
    grid-area: a-4;
  }

   .p_medium {
    grid-area: a-5;
  }

  .portable_text {
    grid-area: a-2;
  }


img .image_wrapper{
  width: 100%;
  height: 40vh;
}

:global(.hero__svg) {
  position: fixed;
  z-index: 2;
  pointer-events: none;
}
:global(.hero__svg--one) {
  left: 10%;
  top: 40%;
  mix-blend-mode: hard-light;
}
:global(.hero__svg--two) {
  top: 10%;
  right: 15%;
  mix-blend-mode: hard-light;
}
:global(.hero__svg img) {
  width: 40vw;
  height: auto;
  will-change: transform;
}

  @media (max-width: 820px) {
  .heading_s_a {
  padding-left: var(--space-1);
}


  .container_grid_two_cols{
    padding: 1.5rem;
    width: 98vw;
}

  }
  @media (max-width: 480px) {

}
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  gsap.to('.hero__svg--one img', {
    rotation: 360,
    ease: 'none',
    scrollTrigger: {
      trigger: 'body',
      start: 'top top',
      end: `+=${window.innerHeight * 5}`,
      scrub: 1,
    }
  })

  gsap.to('.hero__svg--two img', {
    rotation: -360,
    ease: 'none',
    scrollTrigger: {
      trigger: 'body',
      start: 'top top',
      end: '+=3000',
      scrub: 1,
    }
  })
</script>
