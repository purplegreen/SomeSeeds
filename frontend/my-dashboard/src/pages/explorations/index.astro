---
import { getExplorations } from "../../lib/sanity"
import Layout from "../../layouts/Layout.astro"
import ExplorationCard from "../../components/ui/ExplorationCard.astro"

const explorations = await getExplorations()
---

<Layout
  title="Explorations"
  description="Living research containers — each exploring a specific theme or issue through situated practices and activations."
>
  <section class="section">
    <h1 class=".display_l">Explorations</h1>
    <p class="page_description">
      Living research containers — each exploring a specific theme or issue
      through situated practices and activations.
    </p>
  </section>

  <section class="section">
    <div class="explorations-grid">
      {explorations.map((exploration: { title: string; slug: string; summary?: string; coverImage?: string }) => (
        <ExplorationCard
          title={exploration.title}
          slug={exploration.slug}
          summary={exploration.summary}
          coverImage={exploration.coverImage}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
.explorations-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 2rem;
}
</style>
